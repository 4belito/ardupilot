SERVO1_FUNCTION = 77
SERVO2_FUNCTION = 78
SERVO1_REVERSED = 1
SERVO2_REVERSED = 1
# we need small INS_ACC offsets so INS is recognised as being calibrated
INS_ACCOFFS_X   0.001
INS_ACCOFFS_Y   0.001
INS_ACCOFFS_Z   0.001
INS_ACCSCAL_X   1.001
INS_ACCSCAL_Y   1.001
INS_ACCSCAL_Z   1.001
INS_ACC2OFFS_X   0.001
INS_ACC2OFFS_Y   0.001
INS_ACC2OFFS_Z   0.001
INS_ACC2SCAL_X   1.001
INS_ACC2SCAL_Y   1.001
INS_ACC2SCAL_Z   1.001
INS_GYR_CAL      0
ARSPD_TYPE 0
ARSPD_USE 0
AIRSPEED_CRUISE 11
BATT_MONITOR    4
# Without an airspeed sensor TECS disables speed control (SKE_weighting=0).
# SYNAIRSPEED uses GPS groundspeed as a synthetic estimate so TECS can regulate
# speed without a real sensor and without injecting fake wind into the EKF.
TECS_SYNAIRSPEED 1
# Base throttle for TECS cruise. 45% (default) gives ~9-10 m/s on Zephyr;
# 60% centres the throttle range around 12 m/s so TECS can modulate both ways.
TRIM_THROTTLE 60
# 45° gives min turn radius ~15 m at 12 m/s vs ~81 m at the default 20°.
ROLL_LIMIT_DEG 45

# TECS: use pitch for altitude, throttle for speed (standard mode)
# SPDWEIGHT=2.0 was causing pitch-up manoeuvres to bleed excess speed at the TAKEOFF->cruise
# transition, directly triggering the phugoid. SPDWEIGHT=0.5 keeps pitch on altitude.
TECS_SPDWEIGHT 0.5
# TECS_PTCH_DAMP=3.0 was WRONG: at 20 deg/s pitch rate, the damping term was 3.0*(20*pi/180)=1.05 rad=60 deg
# of pitch overcorrection -- self-exciting oscillation rather than damping. Default=0 is correct.
TECS_PTCH_DAMP 0.0
TECS_PITCH_MAX 15
TECS_PITCH_MIN -10
TECS_CLMB_MAX 5.0
# Hard pitch attitude limits
PTCH_LIM_MAX_DEG 15
PTCH_LIM_MIN_DEG -10
# Default THR_SLEWRATE=100. 15 was too slow for TECS to close the energy loop, causing pitch hunting.
THR_SLEWRATE 100
# Allow full unrestricted throttle during TAKEOFF
TKOFF_THR_SLEW -1
TECS_INTEG_GAIN 0.15

# Pitch angle->rate controller: slew-rate limits prevent overshoot at TAKEOFF->AUTO transition
PTCH2SRV_TCONST  0.8
PTCH2SRV_RMAX_UP 20
PTCH2SRV_RMAX_DN 20


# Explicitly define the throttle channel
SERVO3_FUNCTION 70
# Ensure the "Off" PWM is 1000
SERVO3_MIN 1000
SERVO3_TRIM 1000
SERVO3_MAX 2000

# Prevent the motor from spinning at idle when armed
THR_MIN 0
# Ensure throttle is suppressed on the ground
THR_PASS_STAB 0
# Recommended: don't allow any throttle until the plane is ready
TKOFF_THR_MINACC 0

# Loiter radius for DO_REPOSITION (GUIDED mode waypoints) and holding patterns.
# Firmware default is 60 m. At 11 m/s with 45° bank the physical minimum is ~12 m;
# 20 m gives a comfortable margin (≈32° bank).
WP_LOITER_RAD 20

# AUTOLAND geometry (sized for Zephyr at 11 m/s)
# Default 400 m is designed for large aircraft; 150 m fits this scale.
# WP_ALT chosen to maintain ≈7.5° glide slope (150 × tan 7.5° ≈ 20 m).
AUTOLAND_WP_DIST 100
AUTOLAND_WP_ALT  14